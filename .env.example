DATABASE_PATH=./data/database/soli-isle.sqlite
RESOURCE_DIR=./data/images
HOSTNAME=0.0.0.0
PORT=3000
APP_HOST=127.0.0.1
APP_PORT=3000
# Argon2id hash of the Author's password.
# Generate with: npm run auth:reset-password (writes .env, escaping "$").
# If pasting a hash from `npm run auth:hash-password`, escape every "$" as "\$"
# inside the double quotes, or Next.js and Docker Compose will expand it:
# AUTHOR_PASSWORD_HASH="\$argon2id\$v=19\$m=19456,p=1,t=2\$SALT\$HASH"
AUTHOR_PASSWORD_HASH=
