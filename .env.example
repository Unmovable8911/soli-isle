# Copy to .env and adjust. Loaded by compose.yaml via env_file.
# Backend reads these in backend/src/config.ts.

# Required. Admin login password.
ADMIN_PASSWORD=admin

# Session signing secret. MUST be at least 32 characters.
SESSION_SECRET=dev-secret-must-be-32-chars-long!!

# Session expire time, in miliseconds
SESSION_MAX_AGE=1800000

# Optional overrides (defaults shown):
# PORT=3000
# HOST=0.0.0.0
# DB_PATH=./data/soli-isle.db
# MEDIA_DIR=./data/media
